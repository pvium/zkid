# contracts/.env  (git-ignored). Only needed to deploy; tests need none of this.
#
# Networks are listed in deploy.config.ts, each tagged with a Pvium environment:
#   sandbox     baseSepolia                 (sandbox Privy app, testnet stack)
#   production  base, bsc                   (production Privy app, mainnet stack)
# The deploy script reads the values ending in the network's suffix, _SANDBOX or _PROD, so a
# testnet run can never use production keys or owners. Within one environment every chain must
# get identical values: they decide the addresses, and the script refuses a run that differs.

# ---------------------------------------------------------------- sandbox (testnets)
PRIVY_JWKS_URL_SANDBOX=https://auth.privy.io/api/v1/apps/cmhc6t92u001tju0cxkxg34on/jwks.json
# Owner of the factory and the launch policy (timelocked changes, verifier allowlist):
# a Safe at the same address on every sandbox chain.
OWNER_SANDBOX=0x
# Signs screening-constraint commitments, or "none" to disable constraints on this stack.
ATTESTER_SANDBOX=none

# ---------------------------------------------------------------- production (mainnets)
PRIVY_JWKS_URL_PROD=https://auth.privy.io/api/v1/apps/cmjzq9okg01kwjm0cq4b0xs74/jwks.json
OWNER_PROD=0x
ATTESTER_PROD=none

# ---------------------------------------------------------------- deployer
# Pays for the deployment; gets no privileges and does not affect addresses.
# Either one key for everything, or one per environment (the suffixed one wins).
DEPLOYER_KEY=0x
# DEPLOYER_KEY_SANDBOX=0x
# DEPLOYER_KEY_PROD=0x

# ---------------------------------------------------------------- optional
# Shared by both environments unless a _SANDBOX / _PROD variant is set. Defaults shown.
# POLICY_CHANGE_DELAY=604800    # 7 days: notice before a policy change takes effect
#                               (a default-verifier change always needs 14 days, fixed in the factory)
# MIN_REFUND_WINDOW=86400       # 1 day
# MAX_REFUND_WINDOW=7776000     # 90 days
# SCHEME=p2id.vault.v1          # default: `current` in sdks/node/src/p2id.json

# RPC endpoints (public defaults in deploy.config.ts)
# BASE_SEPOLIA_RPC_URL=
# BASE_RPC_URL=
# BSC_RPC_URL=
# ETHERSCAN_API_KEY=            # for `hardhat verify`
