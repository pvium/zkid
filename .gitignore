# --- OS / editors -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- secrets / local config ---------------------------------------------------
.env
.env.*
!.env.example
*.key
# Note: circuit/test/fixtures/test_es256_private.pem is a throwaway TEST key and is
# committed on purpose. Never commit a real signing key.

# --- Node / Yarn ----------------------------------------------------------------
node_modules/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/install-state.gz
# yarn only; see AGENTS.md
package-lock.json

# --- Noir circuit (circuit/) ----------------------------------------------------
# compiled ACIR, witnesses, proofs, vks
circuit/target/
# generated witness inputs (may hold a real token)
circuit/Prover*.toml
circuit/**/*.gz

# --- Hardhat (contracts/) -------------------------------------------------------
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/coverage/
contracts/coverage.json
contracts/gas-report.txt

# --- Node SDK (sdks/node/) ------------------------------------------------------
sdks/node/dist/
# generated by scripts/embed-vk.mjs at build time
sdks/node/src/vk.ts
# generated copy of contracts/src at build time
sdks/node/contracts/

# --- Prover service (http-prover/) ---------------------------------------------------
http-prover/dist/
# SQLite outbox (callback jobs + attestations)
http-prover/data/
# full 13 MB build; the committed artifact is the stripped .json.gz
http-prover/circuit/pvium_identity.json

# --- Python (scripts) -----------------------------------------------------------
__pycache__/
*.pyc
.venv/

# --- Go (future sdks/go) --------------------------------------------------------
sdks/go/bin/
*.test

# --- misc -----------------------------------------------------------------------
*.log
tmp/
