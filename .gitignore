# --- OS / editors -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- secrets / local config ---------------------------------------------------
.env
.env.*
!.env.example
*.key
# Note: circuit/test/fixtures/test_es256_private.pem is a throwaway TEST key and is
# committed on purpose. Never commit a real signing key.

# --- Node / Yarn ----------------------------------------------------------------
node_modules/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/install-state.gz
package-lock.json   # yarn only; see AGENTS.md

# --- Noir circuit (circuit/) ----------------------------------------------------
circuit/target/          # compiled ACIR, witnesses, proofs, vks
circuit/Prover*.toml     # generated witness inputs (may hold a real token)
circuit/**/*.gz

# --- Hardhat (contracts/) -------------------------------------------------------
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/coverage/
contracts/coverage.json
contracts/gas-report.txt

# --- Node SDK (sdks/node/) ------------------------------------------------------
sdks/node/dist/
sdks/node/src/vk.ts      # generated by scripts/embed-vk.mjs at build time
sdks/node/contracts/     # generated copy of contracts/src at build time

# --- Python (scripts) -----------------------------------------------------------
__pycache__/
*.pyc
.venv/

# --- Go (future sdks/go) --------------------------------------------------------
sdks/go/bin/
*.test

# --- misc -----------------------------------------------------------------------
*.log
tmp/
