# Shared secret callers must send as `Authorization: Bearer <AUTH_TOKEN>`
AUTH_TOKEN=change-me
PORT=8787

# Trusted signers: Privy JWKS URL(s), comma-separated to trust several apps (e.g. production and
# sandbox) from one process. The token's kid + signature select the key; callers never choose.
# Pvium production app: cmjzq9okg01kwjm0cq4b0xs74   sandbox app: cmhc6t92u001tju0cxkxg34on
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/cmjzq9okg01kwjm0cq4b0xs74/jwks.json,https://auth.privy.io/api/v1/apps/cmhc6t92u001tju0cxkxg34on/jwks.json
#PRIVY_PUBLIC_KEY_PEM_FILE=./privy_es256_public.pem

# Circuit artifacts (run `yarn sync` to copy them from ../circuit)
CIRCUIT_JSON=./circuit/pvium_identity.json
VK_PATH=./circuit/vk
CIRCUIT_VERSION_JSON=./circuit/version.json

# Barretenberg prover binary, pinned to 5.0.0-nightly.20260522. Leave unset to use ~/.bb/bb (where
# bbup installs it); otherwise give an ABSOLUTE path — a bare name is looked up on the PM2 process's
# PATH, which is usually not your shell's. Checked at startup.
#BB_BIN=/home/deploy/.bb/bb

# One prove takes ~3 GB peak; set to floor(RAM / 3 GB)
MAX_CONCURRENCY=1
# Requests allowed to wait for a slot; beyond this, 503 + Retry-After
MAX_QUEUE=20
# Callback URLs must be https unless this is true (development only)
#ALLOW_HTTP_CALLBACKS=false
# SQLite outbox: callback jobs (with their attestations) persist here until delivered
DB_PATH=./data/prover.db
# How often undelivered callbacks are retried (ms)
DISPATCH_INTERVAL_MS=30000
# Scratch dir for witness/proof files (tmpfs such as /dev/shm on Linux keeps tokens off disk)
WORK_DIR=/tmp
